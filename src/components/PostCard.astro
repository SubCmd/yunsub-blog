---
import { tagLabel } from '../consts';
import FormattedDate from './FormattedDate.astro';

interface Props {
	href: string;
	title: string;
	description: string;
	pubDate: Date;
	tags?: string[];
}

const { href, title, description, pubDate, tags = [] } = Astro.props;
---

<article>
	<a href={href}>
		<div class="meta">
			<FormattedDate date={pubDate} />
			{tags.length > 0 && <span class="dot">·</span>}
			{tags.map((tag) => <span class="tag">{tagLabel(tag)}</span>)}
		</div>
		<h3>{title}</h3>
		<p>{description}</p>
	</a>
</article>

<style>
	article {
		border-bottom: 1px solid var(--border);
	}
	article:last-child {
		border-bottom: none;
	}
	a {
		display: block;
		padding: 1.5rem 0;
		text-decoration: none;
		color: inherit;
	}
	a:hover h3 {
		color: var(--accent);
	}
	.meta {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.4rem;
		font-size: 0.8125rem;
		color: var(--text-muted);
	}
	.tag {
		color: var(--accent);
		font-weight: 600;
	}
	h3 {
		margin: 0.35rem 0 0.4rem;
		transition: color 0.18s ease;
	}
	p {
		margin: 0;
		color: var(--text-muted);
		font-size: 0.9375rem;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
</style>
