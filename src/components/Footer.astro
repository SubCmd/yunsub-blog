---
import { PROFILE } from '../consts';
import SocialLinks from './SocialLinks.astro';

const year = new Date().getFullYear();
---

<footer>
	<div class="wrap inner">
		<p>&copy; {year} {PROFILE.name} · {PROFILE.role}</p>
		<div class="right">
			<a href="/rss.xml">RSS</a>
			<SocialLinks />
		</div>
	</div>
</footer>

<style>
	footer {
		margin-top: 5rem;
		border-top: 1px solid var(--border);
		padding: 2rem 0 3rem;
		font-size: 0.875rem;
		color: var(--text-muted);
	}
	.inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 1rem;
	}
	.inner p {
		margin: 0;
	}
	.right {
		display: flex;
		align-items: center;
		gap: 1.25rem;
	}
	.right a {
		color: var(--text-muted);
		text-decoration: none;
	}
	.right a:hover {
		color: var(--accent);
	}
</style>
