---
import { NAV, PROFILE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import SocialLinks from './SocialLinks.astro';
---

<header>
	<nav class="wrap">
		<a href="/" class="brand">{PROFILE.nameEn}<span>.dev</span></a>
		<div class="links">
			{NAV.map(({ href, label }) => <HeaderLink href={href}>{label}</HeaderLink>)}
		</div>
		<div class="social"><SocialLinks /></div>
	</nav>
</header>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 10;
		background: color-mix(in srgb, var(--bg) 88%, transparent);
		backdrop-filter: blur(10px);
		border-bottom: 1px solid var(--border);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		height: 60px;
	}
	.brand {
		font-size: 1.0625rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		color: var(--text);
		text-decoration: none;
	}
	.brand span {
		color: var(--accent);
	}
	.links {
		display: flex;
		gap: 0.35rem;
	}
	@media (max-width: 640px) {
		.social {
			display: none;
		}
	}
</style>
