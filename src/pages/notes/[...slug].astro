---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';
import { NOTE_CATEGORIES } from '../../consts';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
	const notes = await getCollection('notes', ({ data }) => !data.draft);
	return notes.map((note) => ({
		params: { slug: note.id },
		props: note,
	}));
}

type Props = CollectionEntry<'notes'>;

const note = Astro.props;
const { title, category, by, rating, description, date, keywords } = note.data;
const { Content } = await render(note);
---

<BaseLayout title={title} description={description}>
	<article class="wrap-narrow">
		<header>
			<p class="eyebrow">{NOTE_CATEGORIES[category].label}</p>
			<h1>{title}</h1>
			{by && <p class="by">{by}</p>}
			<div class="meta">
				<FormattedDate date={date} />
				{
					rating && (
						<span class="rating">
							<span aria-hidden="true">
								{'★'.repeat(rating)}
								{'☆'.repeat(5 - rating)}
							</span>
							<span class="sr-only">5점 만점에 {rating}점</span>
						</span>
					)
				}
			</div>
			{
				keywords.length > 0 && (
					<ul class="chip-row">
						{keywords.map((k) => (
							<li class="chip">{k}</li>
						))}
					</ul>
				)
			}
		</header>

		<div class="prose">
			<Content />
		</div>

		<a class="back" href="/notes">← Notes 전체 보기</a>
	</article>
</BaseLayout>

<style>
	header {
		padding: 3.5rem 0 1.5rem;
		border-bottom: 1px solid var(--border);
		margin-bottom: 2.5rem;
	}
	header h1 {
		font-size: clamp(1.7rem, 4vw, 2.2rem);
		margin-bottom: 0.3rem;
	}
	.by {
		margin: 0 0 0.75rem;
		color: var(--text-muted);
	}
	.meta {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 1rem;
		font-size: 0.8125rem;
		color: var(--text-muted);
	}
	.rating {
		color: var(--accent);
		letter-spacing: 0.05em;
	}
	.prose :global(h2) {
		margin-top: 2.25rem;
	}
	.back {
		display: inline-block;
		margin: 2rem 0 1rem;
		font-size: 0.875rem;
		font-weight: 600;
		text-decoration: none;
	}
</style>
