---
import { getCollection } from 'astro:content';
import PostCard from '../../components/PostCard.astro';
import { tagLabel } from '../../consts';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const tags = [...new Set(posts.flatMap((post) => post.data.tags))].sort();
---

<BaseLayout title="Blog" description="개발하면서 배운 것, 커리어 고민, 그리고 일상 기록.">
	<div class="wrap-narrow head">
		<p class="eyebrow">Blog</p>
		<h1>기록</h1>
		<p class="muted">배운 것과 막혔던 것을 남깁니다. 삽질 기록이 가장 오래 쓸모 있습니다.</p>
		{
			tags.length > 0 && (
				<ul class="chip-row filters">
					<li>
						<span class="chip" aria-current="true">
							전체
						</span>
					</li>
					{tags.map((tag) => (
						<li>
							<a class="chip" href={`/blog/tags/${tag}/`}>
								{tagLabel(tag)}
							</a>
						</li>
					))}
				</ul>
			)
		}
	</div>

	<div class="wrap-narrow list">
		{
			posts.length > 0 ? (
				posts.map((post) => (
					<PostCard
						href={`/blog/${post.id}/`}
						title={post.data.title}
						description={post.data.description}
						pubDate={post.data.pubDate}
						tags={post.data.tags}
					/>
				))
			) : (
				<p class="muted">아직 발행한 글이 없습니다.</p>
			)
		}
	</div>
</BaseLayout>

<style>
	.head {
		padding: 3.5rem 0 1.5rem;
	}
	.head h1 {
		margin-bottom: 0.5rem;
	}
	.head p.muted {
		margin: 0 0 1.5rem;
	}
	.filters {
		margin: 0;
	}
	.list {
		border-top: 1px solid var(--border);
	}
</style>
