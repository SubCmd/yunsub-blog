---
import { getCollection } from 'astro:content';
import NoteCard from '../components/NoteCard.astro';
import PostCard from '../components/PostCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { PROFILE, SITE_DESCRIPTION, SITE_TITLE, SKILLS } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = (await getCollection('projects', ({ data }) => !data.draft && data.featured))
	.sort((a, b) => a.data.order - b.data.order)
	.slice(0, 3);

const posts = (await getCollection('blog', ({ data }) => !data.draft))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 4);

const notes = (await getCollection('notes', ({ data }) => !data.draft))
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
	.slice(0, 3);
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<section class="hero wrap">
		<p class="eyebrow">{PROFILE.role} · {PROFILE.location}</p>
		<h1>{PROFILE.tagline}</h1>
		<p class="lead">{PROFILE.intro}</p>
		<div class="actions">
			<a class="btn btn-primary" href="/projects">프로젝트 보기</a>
			<a class="btn btn-ghost" href="/about">이력 보기</a>
			<a class="btn btn-ghost" href={`mailto:${PROFILE.email}`}>연락하기</a>
		</div>
	</section>

	<section class="wrap block">
		<h2>핵심 역량</h2>
		<div class="skills">
			{
				SKILLS.map(({ area, items }) => (
					<div class="skill">
						<h3>{area}</h3>
						<ul>{items.map((item) => <li>{item}</li>)}</ul>
					</div>
				))
			}
		</div>
	</section>

	<section class="wrap block">
		<div class="block-head">
			<h2>대표 프로젝트</h2>
			<a href="/projects">전체 보기 →</a>
		</div>
		{
			projects.length > 0 ? (
				<div class="projects">
					{projects.map((project) => (
						<ProjectCard
							href={`/projects/${project.id}/`}
							title={project.data.title}
							description={project.data.description}
							period={project.data.period}
							role={project.data.role}
							stack={project.data.stack}
						/>
					))}
				</div>
			) : (
				<p class="muted">
					아직 공개한 프로젝트가 없습니다. <code>src/content/projects/</code>에 파일을 추가하고
					<code>featured: true</code>로 표시하세요.
				</p>
			)
		}
	</section>

	<section class="wrap block">
		<div class="block-head">
			<h2>최신 글</h2>
			<a href="/blog">전체 보기 →</a>
		</div>
		{
			posts.length > 0 ? (
				<div class="posts">
					{posts.map((post) => (
						<PostCard
							href={`/blog/${post.id}/`}
							title={post.data.title}
							description={post.data.description}
							pubDate={post.data.pubDate}
							tags={post.data.tags}
						/>
					))}
				</div>
			) : (
				<p class="muted">아직 발행한 글이 없습니다.</p>
			)
		}
	</section>

	{
		notes.length > 0 && (
			<section class="wrap block">
				<div class="block-head">
					<h2>요즘 읽고 맡는 것</h2>
					<a href="/notes">전체 보기 →</a>
				</div>
				<div class="notes">
					{notes.map((note) => (
						<NoteCard
							href={`/notes/${note.id}/`}
							title={note.data.title}
							category={note.data.category}
							by={note.data.by}
							rating={note.data.rating}
							description={note.data.description}
							date={note.data.date}
							keywords={note.data.keywords}
						/>
					))}
				</div>
			</section>
		)
	}
</BaseLayout>

<style>
	.hero {
		padding: 5rem 0 3.5rem;
	}
	.hero h1 {
		max-width: 20ch;
		font-size: clamp(2rem, 5vw, 3rem);
		margin-bottom: 1rem;
	}
	.lead {
		max-width: 52ch;
		font-size: 1.0625rem;
		color: var(--text-muted);
		margin-bottom: 2rem;
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
	}

	.block {
		padding: 3rem 0;
		border-top: 1px solid var(--border);
	}
	.block-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1.25rem;
	}
	.block-head h2 {
		margin: 0;
	}
	.block-head a {
		font-size: 0.875rem;
		font-weight: 600;
		text-decoration: none;
		white-space: nowrap;
	}
	.block > h2 {
		margin-bottom: 1.5rem;
	}

	.skills {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
		gap: 1.5rem;
	}
	.skill h3 {
		font-size: 0.8125rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--accent);
		padding-bottom: 0.5rem;
		border-bottom: 2px solid var(--accent-line);
	}
	.skill ul {
		list-style: none;
		margin: 0.75rem 0 0;
		padding: 0;
		font-size: 0.9375rem;
	}
	.skill li {
		padding: 0.2rem 0;
		color: var(--text-muted);
	}

	.projects {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: 1rem;
	}

	.posts {
		border-top: 1px solid var(--border);
	}

	.notes {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: 1rem;
	}
</style>
